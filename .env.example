# Copy this file to .env.local and fill in your values.
# .env.local is git-ignored, so your real values stay off GitHub.
# Find both values in the Supabase dashboard: Project Settings → API Keys / Connect.
# Only ever use the PUBLISHABLE key here — never the secret / service-role key.
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxx
